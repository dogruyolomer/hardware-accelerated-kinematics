// ==========================================
// Physical Constraints for Tang Nano 20K
// Maps logic ports to physical silicon pins.
// ==========================================

// System Clock (27 MHz Oscillator)
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Hardware Reset Button
IO_LOC "reset" 88;
IO_PORT "reset" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART TX (FPGA Output -> PC)
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// UART RX (PC Output -> FPGA Input)
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Debug LEDs (Active-Low)
IO_LOC "leds[1]" 19;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[0]" 20;
IO_PORT "leds[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
